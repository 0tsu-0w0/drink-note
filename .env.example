# Supabase プロジェクトの Settings → API から取得します。
# どちらも公開してよい値です。service_role キーは絶対にここへ書かないでください。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# アプリの公開 URL（認証メールのリダイレクト先に使います）
# ローカル: http://localhost:3000 / 本番: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
