# Supabase プロジェクトの Settings → API から取得します。
# どちらも公開してよい値です。service_role キーは絶対にここへ書かないでください。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意。独自ドメインなど、実際のアクセス先とは別の URL を正としたい場合だけ設定します。
# 未設定ならアクセスされたドメインから自動で決まるので、通常は不要です。
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
